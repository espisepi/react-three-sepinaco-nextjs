{
  "name": "react-three-next",
  "version": "2.0.0",
  "main": "main/main.js",
  "author": "Renaud ROHLINGER <https://twitter.com/onirenaud>",
  "description": "React Three.js + Next.js + Electron desktop application",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=14"
  },
  "scripts": {
    "lint": "next lint --fix --dir app",
    "dev": "concurrently -n \"NEXT,ELECTRON\" -c \"yellow,blue\" --kill-others \"next dev\" \"electron .\"",
    "dev:next": "next dev",
    "build": "./build-electron.sh",
    "build:next": "next build",
    "analyze": "ANALYZE=true next build",
    "start": "next start",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@ducanh2912/next-pwa": "^10.0.0",
    "@react-three/drei": "^9.92.7",
    "@react-three/fiber": "^8.15.12",
    "electron-serve": "^3.0.0",
    "glsl-random": "^0.0.5",
    "next": "^14.0.4",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "three": "^0.160.0",
    "three-stdlib": "^2.28.9",
    "tunnel-rat": "^0.1.2"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^14.0.4",
    "@next/swc-darwin-arm64": "^15.5.4",
    "@studio-freight/lenis": "^1.0.42",
    "@swc/core-darwin-arm64": "^1.13.5",
    "@types/node": "^24.3.1",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@types/three": "^0.180.0",
    "autoprefixer": "^10.4.16",
    "concurrently": "^9.2.1",
    "electron": "^38.1.2",
    "electron-builder": "^26.0.12",
    "eslint": "^8.56.0",
    "eslint-config-next": "^14.0.4",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-tailwindcss": "^3.13.0",
    "file-loader": "^6.2.0",
    "glslify": "^7.1.1",
    "glslify-loader": "^2.0.0",
    "postcss": "^8.4.32",
    "prettier": "^3.1.1",
    "raw-loader": "^4.0.2",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.8.3",
    "url-loader": "^4.1.1"
